{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Launch KidsLearningApp locally",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build current app for verification",
			"type": "shell",
			"command": "npm run build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run smoke tests",
			"type": "shell",
			"command": "node",
			"args": ["--test", "test/smoke.test.js"],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}